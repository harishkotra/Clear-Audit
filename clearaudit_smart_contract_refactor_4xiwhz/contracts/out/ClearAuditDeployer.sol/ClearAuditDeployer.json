:21;1982:4;2051:6;2045:13;2094:6;2089:2;2078:9;2074:18;2067:34;2153:6;2148:2;2140:6;2136:15;2131:2;2120:9;2116:18;2110:50;2209:1;2204:2;2195:6;2184:9;2180:22;2176:31;2169:42;2279:2;2272;2268:7;2263:2;2255:6;2251:15;2247:29;2236:9;2232:45;2228:54;2220:62;;;1872:416;;;;:::o;3007:277::-;3074:6;3127:2;3115:9;3106:7;3102:23;3098:32;3095:52;;;3143:1;3140;3133:12;3095:52;3175:9;3169:16;3228:5;3221:13;3214:21;3207:5;3204:32;3194:60;;3250:1;3247;3240:12;3194:60;3273:5;3007:277;-1:-1:-1;;;3007:277:46:o;3499:271::-;3682:6;3674;3669:3;3656:33;3638:3;3708:16;;3733:13;;;3708:16;3499:271;-1:-1:-1;3499:271:46:o","linkReferences":{},"immutableReferences":{"535":[{"start":338,"length":32},{"start":434,"length":32},{"start":692,"length":32},{"start":918,"length":32}],"538":[{"start":389,"length":32}],"541":[{"start":141,"length":32},{"start":984,"length":32}]}},"methodIdentifiers":{"BURN()":"c0a2526c","admin()":"f851a440","callPaymaster(bytes)":"a6746de7","paymaster()":"16e4cbf9","sweepNative(address,uint256)":"9646f3ea","sweepToken(address,address,uint256)":"64aff9ec","vault()":"fbfa77cf"},"rawMetadata":"{\"compiler\":{\"version\":\"0.8.28+commit.7893614a\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"entryPoint\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"arbitrator\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"admin_\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"constructor\"},{\"inputs\":[],\"name\":\"BurnAddress\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"CallFailed\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"NativeTransferFailed\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"OnlyAdmin\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"PredictionMismatch\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"TransferFailed\",\"type\":\"error\"},{\"inputs\":[],\"name\":\"ZeroAddress\",\"type\":\"error\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"vault\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"paymaster\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"arbitrator\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"admin\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"address\",\"name\":\"entryPoint\",\"type\":\"address\"}],\"name\":\"Deployed\",\"type\":\"event\"},{\"inputs\":[],\"name\":\"BURN\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"admin\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bytes\",\"name\":\"data\",\"type\":\"bytes\"}],\"name\":\"callPaymaster\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"\",\"type\":\"bytes\"}],\"stateMutability\":\"payable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"paymaster\",\"outputs\":[{\"internalType\":\"contract USDCPaymaster\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address payable\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"sweepNative\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"sweepToken\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"vault\",\"outputs\":[{\"internalType\":\"contract BountyVault\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"details\":\"Judge note: BountyVault fixes its paymaster immutably, while USDCPaymaster fixes its vault immutably. Neither can be patched after deployment. The Arc deployment wallet may be a smart-contract account, so predicting a child from the wallet's transaction nonce is not a valid deployment strategy. Instead, this fresh relayer creates both contracts in its own constructor, using its own known CREATE nonce sequence, independently of how the wallet deploys it. Ownership is admin -> relayer -> paymaster owner: USDCPaymaster's constructor observes this relayer as msg.sender. The immutable admin may call ONLY that paymaster through the adapter, not arbitrary targets. BountyVault has no owner functions; its arbitrator is immutable and is not controlled by this adapter. There is no upgrade mechanism, admin replacement, or selfdestruct.\",\"kind\":\"dev\",\"methods\":{\"callPaymaster(bytes)\":{\"details\":\"This is CALL, not delegatecall, and the target cannot be supplied by the admin. Examples include sponsorship settings, EntryPoint deposits and withdrawals, and withdrawFees(). Original paymaster revert data is preserved.\"},\"sweepNative(address,uint256)\":{\"details\":\"Judge note: Arc native USDC uses 18 decimals, while its ERC-20 view uses 6. Both views represent the same underlying balance, not two assets. Sub-1e12 native-unit remainders are only recoverable through this native path. The amount is denominated in native (18-decimal) units, and only the immutable admin may initiate the transfer.\"},\"sweepToken(address,address,uint256)\":{\"details\":\"Paymaster withdrawFees() pays its owner (this relayer), not admin. The token must implement the existing project's boolean-return ERC-20 ABI. On Arc, use sweepNative() for sub-1e12 native-unit remainders that are invisible through the 6-decimal ERC-20 view of the same USDC balance.\"}},\"title\":\"ClearAuditDeployer\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"callPaymaster(bytes)\":{\"notice\":\"Operate the immutable paymaster as its owner, forwarding msg.value.\"},\"sweepNative(address,uint256)\":{\"notice\":\"Recover native funds held by the relayer to a nonzero recipient.\"},\"sweepToken(address,address,uint256)\":{\"notice\":\"Recover ERC-20 balances held by the relayer to a nonzero recipient.\"}},\"notice\":\"One-shot deployment relayer and narrowly scoped paymaster-owner adapter.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/ClearAuditDeployer.sol\":\"ClearAuditDeployer\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":@openzeppelin/contracts/=node_modules/@openzeppelin/contracts/\",\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"contracts/BountyVault.sol\":{\"keccak256\":\"0x4d14d450e515b100be94d7ffa45f7f8e477def443aa03d685c8718205f9ff299\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://f22fe26ee2e23aad3845d5082cb468a8946e5c76b636639331a9aad873484a96\",\"dweb:/ipfs/QmZEVRtgKgwFXdAev1PadJVjnFFCpAYvswM6tyuzEyzmXN\"]},\"contracts/ClearAuditDeployer.sol\":{\"keccak256\":\"0x0207a05f9e90f984aee1e4bcdf87f5650ff2bfe509184c177a25cc6b74000c94\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://6ac1ff6efb2840a9b54a3fdc58dd8c584cb51c504a8c072a581e4fbce97789ea\",\"dweb:/ipfs/QmNf59YCrUEmtjePHJSQd8qBhFmxkuTZ1hr1oACWDR7VKp\"]},\"contracts/USDCPaymaster.sol\":{\"keccak256\":\"0x72e879a07d5d0ba593ab9f6acf8aa68432b4de6eabf366c68bbe918620f84a22\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://df84a91dcf14966b87e7165a24df2dfce593edcbbec188a7af1db2c83e731074\",\"dweb:/ipfs/QmWVwfoHDUe2pQGL17YmAhB7Q8BXjQJGStPHsPVgahNitz\"]},\"contracts/interfaces/IERC20.sol\":{\"keccak256\":\"0x6cf4893747aa0930bb20b2ba1ef1bbcaadfcb9ee5df1d01467ea8fbc4cf80478\",\"lic
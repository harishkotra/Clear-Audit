{
  "name": "clearaudit",
  "version": "0.1.0",
  "private": true,
  "description": "ClearAudit \u2014 private bug-bounty payouts in USDC on Arc",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "typecheck": "npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "abi": "node scripts/gen-abi.mjs",
    "verify": "npm run abi && npm run typecheck && npm run verify:chain && npm --prefix frontend run build",
    "verify:chain": "tsx scripts/verify-deployment.ts",
    "deploy": "npx arc-studio run \"Deploy BountyVault + USDCPaymaster via ClearAuditDeployer to Arc Testnet\" --session clearaudit",
    "claim": "tsx scripts/claim.ts",
    "arkiv:anchors": "cd frontend && npx tsx scripts/arkiv-anchors.ts",
    "arkiv:whoami": "cd frontend && npx tsx scripts/arkiv-whoami.ts"
  },
  "dependencies": {
    "@forshtat/hegota-support": "^0.0.1",
    "permissionless": "^0.2.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
